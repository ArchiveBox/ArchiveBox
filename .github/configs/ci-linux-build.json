{
  "properties": {
    "CC_BINARY": {
      "default": "cc"
    },
    "LDAPSEARCH_BINARY": {
      "default": "ldapsearch"
    }
  },
  "required_binaries": [
    {
      "name": "{CC_BINARY}",
      "binproviders": "env,apt",
      "overrides": {
        "apt": {
          "install_args": [
            "build-essential"
          ]
        }
      }
    },
    {
      "name": "{LDAPSEARCH_BINARY}",
      "binproviders": "env,apt",
      "overrides": {
        "env": {
          "version": [
            "ldapsearch",
            "-VV"
          ]
        },
        "apt": {
          "install_args": [
            "ldap-utils",
            "python3-dev",
            "python3-setuptools",
            "libssl-dev",
            "libldap2-dev",
            "libsasl2-dev",
            "zlib1g-dev",
            "libatomic1"
          ],
          "version": [
            "ldapsearch",
            "-VV"
          ]
        }
      }
    }
  ]
}
