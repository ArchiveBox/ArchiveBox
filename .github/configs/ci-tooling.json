      "binproviders": "env,brew,apt"
    }
  ],
  "node_binaries": [
    {
      "name": "{NODE_BINARY}",
      "binproviders": "env,npm",
      "min_version": "22.23.1",
      "overrides": {
        "npm": {
          "install_args": [
            "node@22.23.1"
          ],
